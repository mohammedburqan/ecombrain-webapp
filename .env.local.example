# ---------------------------------------------------------------------------
# EcomSkool Companion App — environment variables
# Copy this file to .env.local and fill in values from your Supabase project
# (Supabase dashboard → Project Settings → API).
# ---------------------------------------------------------------------------

# Public Supabase project URL and anon (publishable) key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key — server-side only, NEVER exposed to the browser.
# Used by API routes that must bypass RLS (e.g. server-side gating in later phases).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App base URL (used for auth redirects). In production set to your Vercel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
